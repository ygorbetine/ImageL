{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ImageL",
  "version": "0.3.0",
  "identifier": "io.imagel.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ImageL",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 420,
        "transparent": true,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
