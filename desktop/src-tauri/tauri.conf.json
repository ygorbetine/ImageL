{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ImageL",
  "version": "0.6.0-alpha.45",
  "identifier": "io.imagel.app",
  "build": {
    "frontendDist": "../../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "about:blank",
        "title": "ImageL",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 420,
        "transparent": true,
        "decorations": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "ImageL",
    "shortDescription": "ImageJ com interface moderna",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
